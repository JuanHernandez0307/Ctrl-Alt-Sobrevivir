# Propuesta de configuración para las fases siguientes.
# Este repositorio todavía no implementa un backend que lea este archivo.
# Copiar a .env y completar localmente. Mantener todas las pruebas en Sandbox.
APP_ENV=sandbox
PORT=8000
FRONTEND_ORIGINS=http://localhost:5173
DISPLAY_CURRENCIES=USD,EUR,GBP,MXN,CAD

# Ticketmaster Discovery
TICKETMASTER_BASE_URL=https://app.ticketmaster.com/discovery/v2
TICKETMASTER_API_KEY=

# ExchangeRate-API
EXCHANGERATE_BASE_URL=https://v6.exchangerate-api.com/v6
EXCHANGERATE_API_KEY=

# Factus Pay: /auth usa email y password; el token es distinto del OAuth Factus.
FACTUS_PAY_BASE_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_EMAIL=
FACTUS_PAY_PASSWORD=
FACTUS_PAY_TOKEN=
FACTUS_WEBHOOK_KEY=

# Factus Facturación V2
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
FACTUS_USERNAME=
FACTUS_PASSWORD=
FACTUS_NUMBERING_RANGE_ID=

# URL de PostgreSQL a definir durante la implementación. No publicar credenciales.
DATABASE_URL=
